# client-user/.env.example
# Puertos locales de los servicios (ver launchSettings del auth-service y PORT en restaurant-manager/.env)
EXPO_PUBLIC_AUTH_PORT=5218
EXPO_PUBLIC_RESTAURANT_PORT=3021

# Solo en DISPOSITIVO FÍSICO: IP Wi-Fi de tu PC (la misma que muestra Metro, ej. exp://192.168.1.243:8081)
# En emulador Android se usa 10.0.2.2 automáticamente; no hace falta definir esto.
# EXPO_PUBLIC_DEV_HOST=192.168.1.243

# Override manual (opcional). Si los defines, ignoran la resolución automática de host/puerto.
# EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:5218/api/v1
# EXPO_PUBLIC_RESTAURANT_URL=http://10.0.2.2:3021/brasa33/v1
