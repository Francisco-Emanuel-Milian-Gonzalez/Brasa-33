# ============================================================
# BRASA 33 - Restaurant Manager: Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# ========================
# SERVIDOR
# ========================
PORT=3000
NODE_ENV=development

# ========================
# BASE DE DATOS (PostgreSQL)
# ========================
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=tu_password_aqui
PG_DATABASE=brasa33

# ========================
# AUTENTICACIÓN JWT
# El secreto debe coincidir con el auth-service que emite los tokens.
# El JWT debe incluir: { id, role } donde role es 'admin' | 'manager' | 'client'
# ========================
JWT_SECRET=cambia_este_secreto_en_produccion_minimo_32_caracteres

# ========================
# SWAGGER / API DOCS
# ========================
API_URL=http://localhost:3000
